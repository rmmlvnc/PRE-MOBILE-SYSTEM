{
  "expo": {
    "name": "DengueWatch",
    "slug": "denguewatch-mobile",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "scheme": "denguewatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DengueWatch to access your photos to update your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.denguewatch.iligan.resident",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    }
  }
}
