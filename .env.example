# For normal same-Wi-Fi development, use the computer's LAN IPv4 address.
# For a personal hotspot that blocks direct device-to-laptop traffic, use a
# temporary HTTPS tunnel URL instead, for example https://example.trycloudflare.com/api/mobile.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_WIFI_IPV4:8000/api/mobile
